NODE_ENV=development
LOG_LEVEL=info
HTTP_PORT=3000
SHUTDOWN_TIMEOUT_SEC=30

# The browser reaches the API through the web app's origin (vite.config.ts proxies /v1, /oauth,
# /mcp and /.well-known), so the OAuth issuer and the MCP audience are that origin too.
API_ORIGIN=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
VITE_USERCONTENT_ORIGIN=http://localhost:3002
USERCONTENT_ORIGIN=http://localhost:3002
# Origins that may embed usercontent frames: the web app and the Link page (served by the API, both
# reached by the browser through the vite dev server's own origin). Optional outside production —
# defaults to this same value when unset; required (no default) when NODE_ENV=production.
USERCONTENT_FRAME_ANCESTORS=http://localhost:5173
# The web dev server's own proxy target for /v1, /oauth, /mcp and /.well-known; the API's own HTTP_PORT.
VITE_API_PROXY_TARGET=http://localhost:3000

# The web dev server's proxy (vite.config.ts) never sets forwarding headers, so the peer is the client.
CLIENT_IP_HEADER=none

# Host port of the compose Postgres (read by compose and scripts/local-db.sh only); must match the port in DATABASE_URL.
EXAGRAM_PG_PORT=25432
# Database the compose app containers connect to (compose and scripts/local-db.sh only); `make local-db-init` sets it per checkout.
EXAGRAM_DB_NAME=exagram
DATABASE_URL=postgres://exagram:exagram@localhost:25432/exagram?sslmode=disable&search_path=exagram%2Cpublic
DATABASE_MAX_CONNECTIONS=10
# Hosts besides loopback the apps may reach without TLS (sslmode=disable or no sslmode), comma-separated,
# matched exactly; only for a trusted private network. docker-compose.yml sets "postgres" for its containers.
# DATABASE_PLAINTEXT_HOSTS=
# true only when sslrootcert names a CA that belongs to this one database server; required for sslmode=verify-ca.
# DATABASE_CA_SERVER_SPECIFIC=false
# Read only by the api's preflight check (deploy/ compose): DATABASE_URL without search_path, plus golang-migrate's
# table parameters. `make local-migrate-*` derives its own from DATABASE_URL.
# MIGRATE_DATABASE_URL=postgres://exagram:exagram@localhost:25432/exagram?sslmode=disable&x-migrations-table-quoted=1&x-migrations-table=%22public%22.%22schema_migrations%22

SESSION_COOKIE_SECURE=false

SESSION_TTL_SECONDS=1209600

# Optional: set both to enable Google sign-in.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# 32 bytes minimum. Generate with: openssl rand -hex 32
USERCONTENT_TOKEN_SECRET=0123456789abcdef0123456789abcdef
USERCONTENT_TOKEN_TTL_SEC=300

# Objects on local disk. STORAGE_DIR must be absolute: api, worker and usercontent run from
# different directories. This path is for running the apps on the host; docker-compose.yml
# overrides it with its shared objects volume.
STORAGE_DRIVER=filesystem
STORAGE_DIR=/tmp/exagram-objects
# Signs filesystem upload tickets (api only); 32 characters minimum. Generate with: openssl rand -hex 32
UPLOAD_TOKEN_SECRET=dev-only-upload-token-secret-0123456789

# Or an S3-compatible store (unset keys fall back to the SDK default credential chain):
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://localhost:9000
# Plain http is allowed only for a loopback endpoint or a host listed here (comma-separated).
# S3_HTTP_HOSTS=
# Set when S3_ENDPOINT isn't reachable from the browser; https unless loopback.
# S3_PUBLIC_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=exagram
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Defaults to true when S3_ENDPOINT is set, false otherwise.
# S3_FORCE_PATH_STYLE=

# Or Google Cloud Storage (no key means Application Default Credentials):
# STORAGE_DRIVER=gcs
# GCS_BUCKET=
# GCS_PROJECT_ID=
# GCS_SERVICE_ACCOUNT_KEY_BASE64=
# Sign x-goog-if-generation-match: 0 so an upload URL can't overwrite an existing object. Cloud keeps this off
# until its bucket CORS allows that request header.
# GCS_CREATE_ONLY_UPLOADS=false

UPLOAD_MAX_BYTES=20971520
UPLOAD_TICKET_TTL_SECONDS=300

OIDC_COOKIE_KEYS=dev-only-oidc-cookie-keys-0123456789
# JWKS JSON, or a PEM RSA private key (2048+ bits).
OIDC_JWKS={"keys":[]}
MCP_RATE_LIMIT_PER_MINUTE=60
