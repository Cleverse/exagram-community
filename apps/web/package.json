{
	"name": "@exagram/web",
	"version": "0.5.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"start": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "$npm_execpath typecheck && eslint . --report-unused-disable-directives",
		"lint:fix": "$npm_execpath typecheck && eslint . --report-unused-disable-directives --fix",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest --passWithNoTests",
		"e2e:fixtures": "node e2e/fixtures/make-fixtures.mjs",
		"test:e2e": "pnpm e2e:fixtures && playwright test",
		"test:e2e:ui": "pnpm e2e:fixtures && playwright test --ui"
	},
	"dependencies": {
		"@exagram/api-client": "workspace:*",
		"@tanstack/react-query": "5.102.8",
		"clsx": "2.1.1",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-markdown": "10.1.0",
		"react-router": "7.18.3",
		"remark-gfm": "4.0.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@exagram/dotrc": "workspace:*",
		"@playwright/test": "1.63.0",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.7",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "5.1.0",
		"eslint": "catalog:",
		"happy-dom": "20.14.5",
		"tailwindcss": "4.3.3",
		"typescript": "catalog:",
		"vite": "7.3.6",
		"exceljs": "4.4.0",
		"vitest": "catalog:"
	}
}
