{
	"name": "@exagram/api",
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"build": "$npm_execpath typecheck && tsup",
		"start": "node dist/index.js",
		"dev": "node --import tsx src/index.ts",
		"typecheck": "tsc --noEmit",
		"lint": "$npm_execpath typecheck && eslint . --report-unused-disable-directives",
		"lint:fix": "$npm_execpath typecheck && eslint . --report-unused-disable-directives --fix",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest --passWithNoTests",
		"test:integration": "vitest run -c vitest.integration.config.ts --passWithNoTests"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "catalog:",
		"@aws-sdk/s3-request-presigner": "catalog:",
		"@fastify/cookie": "11.0.2",
		"@google-cloud/storage": "catalog:",
		"@modelcontextprotocol/sdk": "catalog:",
		"@orpc/contract": "catalog:",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"argon2": "catalog:",
		"fastify": "catalog:",
		"fastify-plugin": "5.0.1",
		"jose": "catalog:",
		"oidc-provider": "catalog:",
		"pg-boss": "catalog:",
		"pino": "catalog:",
		"postgres": "catalog:",
		"uuid": "13.0.2",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@exagram/core": "workspace:*",
		"@exagram/dotrc": "workspace:*",
		"@exagram/mcp": "workspace:*",
		"@exagram/redactor": "workspace:*",
		"@testcontainers/postgresql": "catalog:",
		"@types/node": "catalog:",
		"@types/oidc-provider": "catalog:",
		"eslint": "catalog:",
		"pino-pretty": "catalog:",
		"testcontainers": "catalog:",
		"tsup": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"undici": "^7.29.1",
		"vitest": "catalog:"
	}
}
