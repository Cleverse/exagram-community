# Generate a real .env with ./gen-secrets.sh instead of hand-editing this file. It writes every
# value single-quoted; nothing sources the file.

# Layers, ':'-separated, relative to this directory. compose.yml alone expects an external database;
# add compose.postgres.yml for the bundled one, compose.db-ca.yml to mount DATABASE_CA_FILE,
# compose.tls-external.yml when a TLS-terminating proxy or tunnel sits in front of Caddy.
COMPOSE_FILE='compose.yml:compose.postgres.yml'

# Public DNS names, lower-case, without scheme or port. With Caddy's own TLS (the default), each
# is an A record pointed at this VM before `docker compose up`.
APP_HOST='app.example.com'
UC_HOST='uc.example.com'
# Let's Encrypt account email for ACME (default TLS mode only).
ACME_EMAIL='admin@example.com'
# compose.tls-external.yml only: where Caddy serves both hosts as plain HTTP, and the header the
# proxy in front sets to the client address (Cloudflare: Cf-Connecting-Ip). Caddy trusts it only
# from private addresses and passes it to the api as X-Real-IP.
# HTTP_BIND='127.0.0.1:8080'
# PROXY_CLIENT_IP_HEADER='X-Forwarded-For'
# CLIENT_IP_HEADER=cf-connecting-ip   # only when Cloudflare proxies to Caddy's own TLS and the firewall admits
#                                      # only Cloudflare's addresses; otherwise anyone can set it. Default x-real-ip

NODE_ENV='production'
LOG_LEVEL='info'

# Bundled database (compose.postgres.yml): superuser password, also embedded in both URLs below.
POSTGRES_PASSWORD='replace-with-openssl-rand-hex-24'
# App connection string, schema-qualified.
DATABASE_URL='postgres://exagram:replace-with-openssl-rand-hex-24@postgres:5432/exagram?sslmode=disable&search_path=exagram%2Cpublic'
# Same connection, no search_path, migrations table pinned to public.schema_migrations (see Makefile).
MIGRATE_DATABASE_URL='postgres://exagram:replace-with-openssl-rand-hex-24@postgres:5432/exagram?sslmode=disable&x-migrations-table-quoted=1&x-migrations-table=%22public%22.%22schema_migrations%22'
# External database: sslmode=verify-full (default) or verify-ca; plaintext (sslmode=disable) only
# to a loopback host or one listed here. The bundled layer lists `postgres` itself.
# DATABASE_PLAINTEXT_HOSTS=db.internal
# Private CA (RDS bundle, Cloud SQL server CA): absolute host path, readable by UID 1000, mounted by
# compose.db-ca.yml at /certs/db-ca.pem; both URLs then say sslrootcert=/certs/db-ca.pem.
# DATABASE_CA_FILE=/etc/exagram/db-ca.pem
# Required with sslmode=verify-ca: the CA signs only this one server's certificate.
# DATABASE_CA_SERVER_SPECIFIC=true
# Pool size per app process (postgres.js); default 10.
# DATABASE_MAX_CONNECTIONS=10

# Object store: filesystem (the `objects` volume), s3 (AWS, R2, any S3-compatible) or gcs.
STORAGE_DRIVER='filesystem'
# s3: bucket and its real region (R2: auto). Endpoint only for non-AWS stores; S3_PUBLIC_ENDPOINT
# is where browsers upload and must be https://. Keys optional as a pair (else the instance role).
# S3_BUCKET=exagram
# S3_REGION=us-east-1
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_PUBLIC_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
# S3_HTTP_HOSTS=minio.internal   # hosts allowed an http:// S3_ENDPOINT (trusted private network)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# gcs: bucket; a service account key, or the VM's ambient credentials when unset.
# GCS_BUCKET=exagram
# GCS_PROJECT_ID=
# GCS_SERVICE_ACCOUNT_KEY_BASE64=

# 32+ bytes each. Generate with: openssl rand -hex 32
USERCONTENT_TOKEN_SECRET='replace-with-openssl-rand-hex-32'
# Signs filesystem upload URLs; separate from USERCONTENT_TOKEN_SECRET.
UPLOAD_TOKEN_SECRET='replace-with-openssl-rand-hex-32'
# Optional: set both to enable Google sign-in.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional: set all four to enable Sign in with Apple (see docs/self-host/configuration.md). The private key is the
# .p8 file's PEM on one line, its line breaks written as \n.
# APPLE_SERVICES_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----'
# Signs OAuth sign-in cookies. 32+ bytes.
OIDC_COOKIE_KEYS='replace-with-openssl-rand-hex-32'
# JSON Web Key Set (private + public), one RSA signing key. See gen-secrets.sh.
# Or a PEM RSA private key (2048+ bits).
OIDC_JWKS='{"keys":[]}'
MCP_RATE_LIMIT_PER_MINUTE='60'
