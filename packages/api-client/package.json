{
	"name": "@exagram/api-client",
	"private": true,
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "$npm_execpath typecheck && eslint . --report-unused-disable-directives",
		"lint:fix": "$npm_execpath typecheck && eslint . --report-unused-disable-directives --fix",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest --passWithNoTests"
	},
	"dependencies": {
		"@exagram/core": "workspace:*",
		"@orpc/client": "catalog:",
		"@orpc/contract": "catalog:",
		"@orpc/openapi-client": "catalog:"
	},
	"devDependencies": {
		"@exagram/dotrc": "workspace:*",
		"@types/node": "catalog:",
		"eslint": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
